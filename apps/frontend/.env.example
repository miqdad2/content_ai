# Base URL of the backend API (Express + better-auth).
# Use http://localhost:4000 for local dev.
VITE_API_URL=http://localhost:4000

# Set to "true" to run the frontend against a built-in demo sandbox instead of
# the real backend (fixed login demo@content.ai / demo1234, sample data, no
# network calls) — for frontend-only deployments (e.g. a Vercel client
# preview) with no backend reachable. See src/lib/demoMode.ts.
VITE_DEMO_MODE=false
